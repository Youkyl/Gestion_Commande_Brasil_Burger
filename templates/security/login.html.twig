{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

        {% block stylesheets %}


<style>
/* ========== RESET ========== */
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: 'Segoe UI', system-ui, sans-serif;
}

/* ========== BACKGROUND ========== */
.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #fb923c, #ef4444, #ec4899);
  position: relative;
  overflow: hidden;
}

/* grid pattern */
.page::after {
  /*content: "";*/
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
  background-size: 60px 60px;
  opacity: .25;
}

/* floating blobs */
.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: .25;
}
.blob.orange { background:#fff; width:280px;height:280px;top:80px;left:40px;}
.blob.yellow { background:#fde047;width:380px;height:380px;bottom:60px;right:60px;}
.blob.pink { background:#f9a8d4;width:260px;height:260px;top:50%;left:30%;}

/* ========== CONTENT ========== */
.content {
  position: relative;
  min-height: 100vh;
  padding: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* back button */
.back {
  position: absolute;
  top: 32px;
  left: 32px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-radius: 14px;
  background: rgba(255,255,255,.12);
  color: white;
  border: none;
  cursor: pointer;
}

/* layout */
.layout {
  max-width: 1200px;
  width: 100%;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 48px;
}

/* ========== LEFT ========== */
.left {
  color: white;
}

.brand {
  display: flex;
  gap: 20px;
  align-items: center;
  margin-bottom: 32px;
}

.logo {
  width: 80px;
  height: 80px;
  border-radius: 22px;
  background: rgba(255,255,255,.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
}

.brand h1 {
  font-size: 48px;
  margin: 0;
  font-weight: 900;
}

.brand p {
  margin: 6px 0 0;
  font-size: 20px;
  opacity: .9;
}

.feature {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  background: rgba(0,0,0,.25);
  padding: 18px;
  border-radius: 16px;
  margin-bottom: 16px;
}

.feature-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.orange {background:#f97316;}
.pink {background:#ec4899;}
.yellow {background:#eab308;}

/* ========== CARD ========== */
.card {
  background: white;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 30px 70px rgba(0,0,0,.35);
}

.card-header {
  padding: 32px;
  background: linear-gradient(135deg, #f97316, #dc2626);
  color: white;
}

.card-header h2 {
  margin: 0 0 6px;
  font-size: 32px;
}

.card-body {
  padding: 32px;
}

.field {
  margin-bottom: 18px;
}

label {
  display: block;
  font-size: 14px;
  margin-bottom: 8px;
  color: #444;
}

.form-control {
  width: 100%;
  padding: 14px 14px 14px 44px;
  border-radius: 14px;
  border: 2px solid #e5e7eb;
  font-size: 15px;
}

.form-control:focus {
  outline: none;
  border-color: #f97316;
}

.icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: #9ca3af;
}

.input-wrap {
  position: relative;
}

.submit {
  width: 100%;
  margin-top: 10px;
  padding: 16px;
  border-radius: 16px;
  border: none;
  font-size: 16px;
  font-weight: 600;
  color: white;
  background: linear-gradient(90deg,#f97316,#dc2626);
  cursor: pointer;
}

.switch {
  margin-top: 20px;
  text-align: center;
  color: #f97316;
  font-weight: 500;
  cursor: pointer;
}

/* ========== RESPONSIVE ========== */
@media(max-width: 992px){
  .layout {
    grid-template-columns: 1fr;
  }
  .left {
    display: none;
  }
}
</style>

        {% endblock %}

                {% block bootstrap %}

                <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
                
                {% endblock %}

{% block body %}



  <div class="page">
  <div class="blob orange"></div>
  <div class="blob yellow"></div>
  <div class="blob pink"></div>

  <div class="content">

    <div class="layout">



      <div class="left">
        <div class="brand">
          <div class="logo">🍔</div>
          <div>
            <h1>Brasil Burger</h1>
            <p>✨ Le goût du Brésil à portée de clic</p>
          </div>
        </div>

        <div class="feature">
          <div class="feature-icon orange"><i class="bi bi-lightning-charge"></i></div>
          <div>
            <strong>Commande en ligne</strong><br>
            Commandez vos burgers favoris en quelques clics
          </div>
        </div>

        <div class="feature">
          <div class="feature-icon pink"><i class="bi bi-truck"></i></div>
          <div>
            <strong>Livraison rapide</strong><br>
            Recevez votre commande où vous voulez
          </div>
        </div>

        <div class="feature">
          <div class="feature-icon yellow"><i class="bi bi-shield-check"></i></div>
          <div>
            <strong>Paiement sécurisé</strong><br>
            Wave & Orange Money intégrés
          </div>
        </div>
      </div>
      

      <div class="card">
        <div class="card-header">
          <h2>Bienvenue !</h2>
          <p>Connectez-vous pour continuer</p>
        </div>


<form method="post" class="card-body">

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}


        <div >
        
          <div class="field">
            <label for="inputEmail">Email</label>
            <div class="input-wrap">
              <i class="bi bi-envelope icon"></i>
              <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="exemple@email.com">
            </div>
          </div>

          

          <div class="field">
            <label for="inputPassword">Mot de passe</label>
            <div class="input-wrap">
              <i class="bi bi-lock icon"></i>
              <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="••••••••">
            </div>
          </div>

          
          <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="checkbox mb-3">
                <label>
                    <input type="checkbox" name="_remember_me"> Remember me
                </label>
            </div>

          <button type="submit" class="submit">
            <i class="bi bi-box-arrow-in-right"></i> Se connecter
          </button>

</form>

          <div class="switch">
            Pas encore de compte ? S’inscrire
          </div>
        </div>
      </div>

    </div>
  </div>
</div>




{% endblock %}
