{% extends 'base.html.twig' %}
{% block title %}Gestion des commandes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/commande.css') }}">








    
{% endblock %}

{% block active_commandes %}class="active"{% endblock %}

{% block body %}

<div class="page">


  <main class="main">
    <h1>Gestion des commandes</h1>
    <div class="subtitle">Suivez et gérez toutes les commandes</div>

    <input class="search" placeholder="Rechercher par numéro, client ou produit…">

    <!-- FILTRES -->
    <div class="filters">
      <div class="chip active">Toutes</div>
      <div class="chip">En attente</div>
      <div class="chip">En préparation</div>
      <div class="chip">Prête</div>
      <div class="chip">Terminée</div>
      <div class="chip">Annulée</div>
    </div>

    <!-- TABLE -->
    <div class="table">
      <table>
        <thead>
          <tr>
            <th>Commande</th>
            <th>Client</th>
            <th>Articles</th>
            <th>Type</th>
            <th>Montant</th>
            <th>Paiement</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for c in commandes %}
          <tr>
            <td>
              <strong>{{ c.reference }}</strong><br>
              <small>{{ c.dateCommande|date('d/m/Y H:i') }}</small>
            </td>
            <td>
              {{ c.client.nom }} {{ c.client.prenom }}<br>
              <small>{{ c.client.telephone }}</small>
            </td>
            <td>
                {% for d in c.commandeDetails %}
                    
                    {# Burger ou Menu #}
                    {% if d.burger %}
                    {{ d.burger.nom }}
                    {% elseif d.menu %}
                    {{ d.menu.nom }}
                    {% endif %}

                    {# Quantité #}
                    {% if d.quantite > 1 %}
                    x{{ d.quantite }}
                    {% endif %}

                    {# Compléments #}
                    {% if d.commandeComplements|length > 0 %}
                    (
                    {% for cc in d.commandeComplements %}
                        {{ cc.complement.nom }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                    )
                    {% endif %}

                    {# Séparateur entre lignes #}
                    {% if not loop.last %}<br>{% endif %}

                {% else %}
                    <em>Aucun article</em>
                {% endfor %}
                </td>
            <td><span class="badge wait">{{ c.typeCommande }}</span></td>
            <td>{{ c.montantTotal }} FCFA</td>
<td>
  {% if c.paiement %}
    {{ c.paiement.mode|replace({'_':' '}) }}<br>
    <span class="badge done">Payé</span>
  {% else %}
    <em>Non payé</em><br>
    <span class="badge wait">En attente</span>
  {% endif %}
</td>
            <td>
              <span class="badge
                {{ c.etat == 'EN_COURS' ? 'prep' :
                   c.etat == 'TERMINEE' ? 'done' :
                   c.etat == 'ANNULEE' ? 'cancel' :
                   'wait' }}">
                {{ c.etat|replace({'_':' '}) }}
              </span>
            </td>
            <td>
              <a href="{{ path('commande_show', {'id': c.id}) }}"><span class="link" onclick="openModal({{ c.id }})">Détails</span></a>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </main>
</div>

<script>
function openModal(id) {
  fetch('/commande/' + id)
    .then(r => r.text())
    .then(html => {
      document.body.insertAdjacentHTML('beforeend', html);
    });
}
</script>
{% endblock %}