{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/styles/pages/dashboard.css">
{% endblock %}

{% block active_dashboard %}class="active"{% endblock %}

{% block body %}

<div class="gestionnaire">


  <!-- MAIN -->
  <main class="main">

    <!-- HEADER -->
    <div class="header">
      <div>
        <h1>Tableau de bord</h1>
        <span>Statistiques du {{ "now"|date("d/m/Y") }}</span>
      </div>
      <div class="actions">
        <button>Aujourd’hui</button>
        <button>Cette semaine</button>
        <button class="export">Exporter</button>
      </div>
    </div>

    <!-- STATS -->
    <div class="stats">
    
      <div class="stat blue">
        <div class="stat-normal">
          <div class="stat-content">
            <h3>Commandes en cours</h3>
              <b>{{ enCours }}</b>
                <div class="trend positive"></div>
          </div>
        </div>
      </div>

      <div class="stat green">
        <div class="stat-normal">
          <div class="stat-content">
            <h3>Commandes validées</h3>
              <b>{{ validees }}</b>
                <div class="trend positive"></div>
            </div>
        </div>
      </div>
      
      <div class="stat orange">
        <div class="stat-normal">
          <div class="stat-content">
            <h3>Recettes</h3>
              <b>{{ recettes|number_format(0,' ',' ') }} FCFA</b>
                <div class="trend positive"></div>
            </div>
          </div>
      </div>

      <div class="stat red">
        <div class="stat-normal">
          <div class="stat-content">
            <h3>Annulées</h3>
              <b>{{ annulees }}</b>
                <div class="trend negative"></div>
          </div>
        </div>
      </div>

    </div>

    <!-- GRID -->
    <div class="grid">

      <!-- TOP -->
      <div class="card">
        <div class="card-header">
          <strong>Top ventes du jour</strong>
          <i data-lucide="trending-up"></i>
        </div>
        <div class="card-body">
          {% for p in topProduits %}
            <div class="top-item">
              <div class="rank">{{ loop.index }}</div>
              <div>
                <strong>{{ p.produit }}</strong><br>
                <small>{{ p.total }} ventes</small>
              </div>
            </div>
            {% else %}
              <p>Aucun produit vendu aujourd'hui.</p>
            {% endfor %}
        </div>
      </div>

      <!-- ACTIVITÉ -->
      <div class="card">
        <div class="card-header">
          <strong>Activité</strong>
          <i data-lucide="activity"></i>
        </div>
        <div class="card-body">
          <p>Commandes par heure</p>
        </div>
      </div>

      <!-- COMMANDES -->
      <div class="card" style="grid-column:1/-1">
        <div class="card-header">
          <strong>Commandes récentes</strong>
          <i data-lucide="users"></i>
        </div>
        <div class="card-body">
          {% for c in recentes %}
            <div class="order">
              <div>
                <strong>{{ c.client.nom }} {{ c.client.prenom }}</strong><br>
                <small>{{ c.reference }} • {{ c.dateCommande|date('H:i') }}</small>
              </div>
              <div>
                <strong>{{ c.montantTotal|number_format(0,' ',' ') }} FCFA</strong><br>
                <span class="badge {{ c.etat == 'En cours' ? 'blue' : (c.etat == 'Validée' ? 'green' : 'orange') }}">
                  {{ c.etat }}
                </span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </main>
</div>


{% endblock %}