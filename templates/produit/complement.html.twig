{% extends 'base.html.twig' %}
{% block title %}Gestion des produits{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/produit.css') }}">



<style>
/* ========== GLOBAL ========== */
body {
  margin:0;
  font-family: Inter, Segoe UI, sans-serif;
  background:#fafafa;
}

.app { 
  display:flex; 
  min-height:100vh; 
}

a{
  text-decoration: none;
  color: inherit;
}

/* ========== MAIN ========== */
.main {
  margin-left: 300px;
  flex: 1;
  padding: 32px;
}

/* ========== HEADER ========== */
.header {
  display:flex; 
  justify-content:space-between; 
  align-items:center;
  margin-bottom: 24px;
}

.header h1 { 
  font-size:32px; 
  margin:0; 
}

.header p { 
  color:#6b7280; 
  margin: 8px 0 0 0;
}

.add-btn {
  background:linear-gradient(90deg,#ff6900,#e7000b);
  color:white; 
  border:none;
  padding:12px 20px;
  border-radius:14px;
  cursor:pointer;
  font-weight: 600;
  transition: transform 0.2s ease;
}

.add-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(255, 105, 0, 0.3);
}

/* ========== SEARCH & FILTER ========== */
.filters {
  display:flex; 
  justify-content:space-between;
  gap: 16px;
  margin:24px 0;
}

.search {
  flex:1;
  padding:12px 16px;
  border-radius:14px;
  border:1px solid #e5e7eb;
  font-size: 14px;
  outline: none;
  box-sizing: border-box;
}

.search:focus {
  border-color: #ff6900;
}

.tabs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.tabs button {
  padding:10px 14px;
  border:none;
  border-radius:12px;
  cursor:pointer;
  background: #f3f4f6;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.tabs button:hover {
  background: #e5e7eb;
}

.tabs .active {
  background:#ff6900; 
  color:white;
}

/* ========== PRODUCTS GRID ========== */
h3 {
  color: #374151;
  font-size: 18px;
  margin: 24px 0 16px 0;
}

.grid {
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap:24px;
}

.card {
  background:white;
  border-radius:20px;
  padding:20px;
  box-shadow:0 10px 25px rgba(0,0,0,.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow:0 15px 35px rgba(0,0,0,.12);
}

.badge {
  font-size:12px;
  padding:4px 10px;
  border-radius:999px;
  background:#ffedd4;
  color:#ca3500;
  float:right;
  font-weight: 600;
}

.card h4 {
  margin: 8px 0;
  font-size: 18px;
  color: #111827;
}

.card p {
  color: #6b7280;
  font-size: 14px;
  line-height: 1.5;
  margin: 8px 0;
}

.price {
  color:#ff6900;
  font-weight:700;
  margin:12px 0;
  font-size: 20px;
}

.card-actions {
  display:flex; 
  gap:12px;
  margin-top: 16px;
}

.btn-blue {
  flex:1;
  background:#2563eb;
  color:white; 
  border:none;
  padding:10px; 
  border-radius:12px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.btn-blue:hover {
  background: #1d4ed8;
}

.btn-dark {
  flex:1;
  background:#374151;
  color:white; 
  border:none;
  padding:10px; 
  border-radius:12px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.btn-dark:hover {
  background: #1f2937;
}

.product-image {
  width:100%;
  height:200px;
  object-fit:cover;
  border-radius:16px;
  margin-bottom:12px;
  background: #f3f4f6;
}

/* ========== MODAL ========== */
.modal {
  position:fixed; 
  inset:0;
  background:rgba(0,0,0,.6);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:1000;
}

.modal.active {
  display: flex;
}

.modal-content {
  background:white;
  width:90%;
  max-width: 460px;
  border-radius:20px;
  padding:24px;
  max-height: 90vh;
  overflow-y: auto;
}

.modal-header {
  display:flex; 
  justify-content:space-between;
  align-items: center;
  margin-bottom:16px;
}

.modal-header h3 {
  margin: 0;
}

.modal-header button {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: #6b7280;
  padding: 0;
  width: 32px;
  height: 32px;
}

.modal input, 
.modal textarea {
  width:100%;
  padding:12px;
  margin-bottom:12px;
  border-radius:12px;
  border:1px solid #e5e7eb;
  font-size: 14px;
  font-family: inherit;
  box-sizing: border-box;
  outline: none;
}

.modal input:focus,
.modal textarea:focus {
  border-color: #ff6900;
}

.modal textarea {
  resize: vertical;
  min-height: 80px;
}

.modal-actions {
  display:flex; 
  gap:12px;
  margin-top: 16px;
}

.btn-cancel {
  flex:1;
  background:#e5e7eb;
  border:none;
  padding:12px;
  border-radius:14px;
  cursor: pointer;
  font-weight: 600;
  transition: background 0.2s ease;
}

.btn-cancel:hover {
  background: #d1d5db;
}

.btn-save {
  flex:1;
  background:#ff6900;
  color:white;
  border:none;
  padding:12px;
  border-radius:14px;
  cursor: pointer;
  font-weight: 600;
  transition: background 0.2s ease;
}

.btn-save:hover {
  background: #e7000b;
}

/* ===== BOUTON MENU MOBILE ===== */
.menu-toggle {
  display: none;
  position: fixed;
  top: 20px;
  left: 20px;
  z-index: 1001;
  background: linear-gradient(135deg,#f54900,#c10007);
  color: white;
  border: none;
  width: 50px;
  height: 50px;
  border-radius: 12px;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
  font-size: 24px;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.menu-toggle.active {
  background: linear-gradient(135deg,#c10007,#8b0000);
}

.menu-icon,
.close-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.close-icon {
  opacity: 0;
  transform: translate(-50%, -50%) rotate(90deg);
}

.menu-toggle.active .menu-icon {
  opacity: 0;
  transform: translate(-50%, -50%) rotate(-90deg);
}

.menu-toggle.active .close-icon {
  opacity: 1;
  transform: translate(-50%, -50%) rotate(0deg);
}

.sidebar-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 999;
}

/* ========== RESPONSIVE ========== */

/* Tablettes (≤1200px) */
@media (max-width: 1200px) {
  .grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
}

/* Tablettes petites (≤992px) */
@media (max-width: 992px) {
  .sidebar {
    width: 250px;
  }

  .main {
    margin-left: 270px;
    padding: 24px;
  }

  .header h1 {
    font-size: 28px;
  }

  .grid {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
}

/* Mobile (≤768px) */
@media (max-width: 768px) {
  body {
    overflow-x: hidden;
  }

  .menu-toggle {
    display: flex;
  }

  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    width: 280px;
    position: fixed;
    z-index: 1000;
  }

  .sidebar.active {
    transform: translateX(0);
  }

  .sidebar-overlay.active {
    display: block;
  }

  .main {
    margin-left: 0;
    padding: 80px 16px 20px 16px;
  }

  .header {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .header h1 {
    font-size: 24px;
  }

  .header p {
    font-size: 14px;
  }

  .add-btn {
    width: 100%;
  }

  .filters {
    flex-direction: column;
    gap: 12px;
  }

  .search {
    width: 100%;
  }

  .tabs {
    width: 100%;
    justify-content: flex-start;
  }

  .tabs button {
    flex: 1;
    text-align: center;
    padding: 10px 8px;
    font-size: 13px;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  h3 {
    font-size: 16px;
  }

  .modal-content {
    width: 95%;
    padding: 20px;
  }
}

/* Petit Mobile (≤480px) */
@media (max-width: 480px) {
  .main {
    padding: 70px 12px 16px 12px;
  }

  .header h1 {
    font-size: 22px;
  }

  .header p {
    font-size: 13px;
  }

  .add-btn {
    padding: 10px 16px;
    font-size: 14px;
  }

  .search {
    padding: 10px 14px;
    font-size: 13px;
  }

  .tabs button {
    padding: 8px 6px;
    font-size: 12px;
  }

  .card {
    padding: 16px;
  }

  .product-image {
    height: 180px;
  }

  .card h4 {
    font-size: 16px;
  }

  .card p {
    font-size: 13px;
  }

  .price {
    font-size: 18px;
  }

  .badge {
    font-size: 11px;
    padding: 3px 8px;
  }

  .modal-content {
    padding: 16px;
  }

  .modal input,
  .modal textarea {
    padding: 10px;
    font-size: 13px;
  }

  .btn-cancel,
  .btn-save {
    padding: 10px;
    font-size: 14px;
  }
}
</style>

{% endblock %}

{% block active_produit %}class="active"{% endblock %}

{% block body %}
<div class="app">

  <!-- BOUTON MENU MOBILE -->
  <button class="menu-toggle" id="menuToggle" onclick="toggleSidebar()">
    <span class="menu-icon">☰</span>
    <span class="close-icon">✕</span>
  </button>

  <!-- OVERLAY POUR FERMER LA SIDEBAR -->
  <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

  <!-- MAIN -->
  <main class="main">

    <div class="header">
      <div>
        <h1>Gestion des produits</h1>
        <p>Gérez vos burgers, menus et compléments sur l'application Java</p>
      </div>
      <button class="add-btn" onclick="openAdd()">+ Ajouter un produit</button>
    </div>

    <div class="filters">
      <input class="search" placeholder="Rechercher un produit...">
      <div class="tabs">
        <button>
          <a href="{{ path('produit') }}">Tout</a>
        </button>

        <button>
          <a href="{{ path('burger') }}">Burgers</a>
        </button>

        <button>
          <a href="{{ path('menu') }}">Menus</a>
        </button>
        
        <button class="active">
          <a href="{{ path('complement') }}">Compléments</a>
        </button>
      </div>
    </div>

    <h3>Produits actifs ({{ complement|length }})</h3>

    <div class="grid">
      {% for c in complement %}
      <div class="card">
        <img src="{{ c.image }}" alt="{{ c.nom }}" class="product-image">
        <span class="badge">{{ c.type }}</span>
        <h4>{{ c.nom }}</h4>
        <p>{{ c.description }}</p>
        <div class="price">{{ c.prix }} FCFA</div>
      </div>
      {% endfor %}
    </div>

  </main>
</div>

<!-- MODAL -->
<div class="modal" id="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="modalTitle">Ajouter un produit</h3>
      <button onclick="closeModal()">✕</button>
    </div>
    <input placeholder="Type de produit">
    <input id="nom" placeholder="Nom">
    <textarea placeholder="Description"></textarea>
    <input id="prix" placeholder="Prix FCFA">
    <input placeholder="URL de l'image">
    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeModal()">Annuler</button>
      <button class="btn-save">Enregistrer</button>
    </div>
  </div>
</div>

<script>
function toggleSidebar() {
  const sidebar = document.querySelector('.sidebar');
  const overlay = document.querySelector('.sidebar-overlay');
  const menuToggle = document.getElementById('menuToggle');
  
  if (sidebar) {
    sidebar.classList.toggle('active');
  }
  if (overlay) {
    overlay.classList.toggle('active');
  }
  if (menuToggle) {
    menuToggle.classList.toggle('active');
  }
}

function openAdd() {
  const modal = document.getElementById('modal');
  if (modal) {
    modal.classList.add('active');
  }
}

function closeModal() {
  const modal = document.getElementById('modal');
  if (modal) {
    modal.classList.remove('active');
  }
}

// Fermer le modal en cliquant en dehors
document.getElementById('modal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeModal();
  }
});
</script>

{% endblock %}
