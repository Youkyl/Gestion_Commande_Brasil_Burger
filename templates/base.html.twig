<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block bootstrap %}{% endblock %}

        {% block stylesheets %}
            <link rel="stylesheet" href="../../assets/styles/app.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
    
        {% block body %}{% endblock %}

        {% block navbar %}
        
            <div class="gestionnaire">
                <!-- SIDEBAR -->
                <aside class="sidebar">
                <div>
                    <h1>🍔Brasil Burger</h1>
                    <h2><p>Tableau de gestion</p></h2>
                    

                    <nav class="nav">
                    <a href="{{ path('dashboard') }}" {% block active_dashboard %}{% endblock %} ><i data-lucide="layout-dashboard"></i> Dashboard</a>
                    <a href="{{ path('produit') }}" {% block active_produit %}{% endblock %} ><i data-lucide="package"></i> Produits</a>
                    <a><i data-lucide="shopping-cart" {% block active_commandes %}{% endblock %}></i> Commandes</a>
                    <a><i data-lucide="map" {% block active_zones %}{% endblock %}></i> Zones</a>
                    <a><i data-lucide="users" {% block active_clients %}{% endblock %}></i> Clients</a>
                    <a><i data-lucide="truck" {% block active_livreurs %}{% endblock %}></i> Livreurs</a>
                    <a><i data-lucide="credit-card" {% block active_paiements %}{% endblock %}></i> Paiements</a>
                    </nav>
                </div>

                <!-- Déconnexion -->
                                                    {% if app.user %}
                                                    <div class="logout">
                                                        <a class="dropdown-item" href="{{ path('app_logout') }}"><i data-lucide="log-out"></i> Déconnexion</a>
                                                    </div>
                                                    {% endif %}

                </aside>
            
            </div>
        {% endblock %}
        <script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
</script>
    </body>
</html>
